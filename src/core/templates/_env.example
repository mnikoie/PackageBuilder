# این فایل «نقشهٔ» متغیرهای محیطی است، نه خودشان — کامیت می‌شود و هیچ
# مقدارِ واقعی/رمزی داخلش نیست. برای اجرا، یک کپی از آن با نامِ `.env`
# بساز و مقادیر را پر کن (`.env` در .gitignore هست و کامیت نمی‌شود).
#
# قاعده: یک فایلِ .env در ریشه، برای کلِ پروژه. هرجا متغیرِ جدیدی لازم شد،
# اول یک خطِ توضیح‌دار همین‌جا اضافه کن تا نفرِ بعدی بداند چه لازم است.
#
# چرا الان تقریباً خالی است: تا وقتی تکنولوژی‌ها انتخاب نشده‌اند، معلوم نیست
# چه متغیری لازم است. هر تصمیمی که در docs/decisions ثبت شود، متغیرهای
# خودش را هم همین‌جا اضافه می‌کند (دیتابیس → DATABASE_URL، احرازِ هویت →
# کلیدها، و همین‌طور بقیه).

# ---- نامِ نمایشیِ پروژه ----
APP_NAME={{DISPLAY_NAME}}

# ---- محیطِ اجرا: development | production ----
APP_ENV=development
